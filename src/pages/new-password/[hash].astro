---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import NewPasswordForm from "@/components/Forms/NewPasswordForm";
import { validateHash } from "@/services/fetchData";

const { pathname } = Astro.url;
const hash = pathname.split("/")[2];

const isHashValid = await validateHash(hash);

if (!isHashValid.success) {
  return Astro.redirect("/");
}
---

<Layout title="Nueva contraseña | VIGI">
  <main class="m-auto max-w-[1180px] px-4 py-12 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-md text-center">
      <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
        Elegí una nueva contraseña
      </h1>
      <p class="mt-3 text-[15px] leading-relaxed text-muted">
        Que sea distinta a la anterior y fácil de recordar para vos.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-md rounded-3xl border border-line bg-white p-8 shadow-[0_14px_34px_rgba(30,5,63,0.06)] sm:p-10">
      <NewPasswordForm client:load hash={hash} />
    </div>
  </main>
</Layout>
