---
import { assistantSteps } from "@/services/const";
---

<section
  class="rounded-3xl bg-primary px-6 py-10 sm:px-12 sm:py-12"
  data-assistant
>
  <div class="flex flex-col gap-10 lg:flex-row lg:gap-16">
    <div class="lg:w-[330px] lg:shrink-0">
      <span
        class="text-[11px] font-bold uppercase tracking-[0.11em] text-green_"
        >Encontrá la tuya</span
      >
      <h2
        class="mt-4 text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl"
      >
        Encontrá la tuya en 30 segundos
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-violet-200">
        No hace falta que sepas de cámaras. Contanos qué querés cuidar y del
        resto nos ocupamos nosotros.
      </p>
    </div>

    <div class="flex flex-1 flex-col gap-7">
      {
        assistantSteps.map((step) => (
          <fieldset data-step={step.id}>
            <legend class="mb-3 text-xs font-semibold text-violet-200">
              {step.question}
            </legend>
            <div class="flex flex-wrap gap-2.5">
              {step.options.map((option) => (
                <button
                  type="button"
                  data-option={option.value}
                  class="h-11 rounded-full border-[1.5px] border-violet-800 px-5 text-sm text-white transition-colors hover:border-violet-400 aria-pressed:border-white aria-pressed:bg-white aria-pressed:font-semibold aria-pressed:text-primary"
                  aria-pressed="false"
                >
                  {option.label}
                </button>
              ))}
            </div>
          </fieldset>
        ))
      }

      <a
        data-assistant-cta
        href="/category/promociones"
        class="mt-1 inline-flex h-[52px] w-full items-center justify-center gap-2.5 self-start rounded-full bg-green_ px-8 text-[15px] font-bold text-[#10331d] transition-transform hover:scale-[1.02] sm:w-auto"
      >
        Ver las que coinciden
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M12.5 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Sin framework a propósito: el asistente es un puñado de botones y un href.
  // Metía ~40 KB de React para esto.
  const ROUTES: Record<string, string> = {
    bateria: "/category/bateria",
    local: "/category/kits",
    afuera: "/category/exterior",
    adentro: "/category/interior",
    ambas: "/category/exterior",
  };

  const init = () => {
    const root = document.querySelector<HTMLElement>("[data-assistant]");
    if (!root) return;

    const cta = root.querySelector<HTMLAnchorElement>("[data-assistant-cta]");
    const picked: Record<string, string> = {};

    const resolve = () => {
      // La energía manda: si no hay enchufe, no sirve nada cableado.
      // Después el uso, y por último la ubicación.
      const order = [picked.energia, picked.cuidar, picked.donde];
      const hit = order.find((value) => value && ROUTES[value]);
      return hit ? ROUTES[hit] : "/category/promociones";
    };

    root.querySelectorAll<HTMLElement>("[data-step]").forEach((step) => {
      const stepId = step.dataset.step ?? "";
      step.querySelectorAll<HTMLButtonElement>("[data-option]").forEach((btn) => {
        btn.addEventListener("click", () => {
          step
            .querySelectorAll<HTMLButtonElement>("[data-option]")
            .forEach((sibling) =>
              sibling.setAttribute("aria-pressed", String(sibling === btn)),
            );
          picked[stepId] = btn.dataset.option ?? "";
          if (cta) cta.href = resolve();
        });
      });
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
