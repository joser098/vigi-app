---
import Layout from "../layouts/Layout.astro";
import { categories } from "@/services/const";
---

<Layout title="Ups! | VIGI">
  <main class="m-auto flex max-w-[1180px] flex-col gap-12 px-4 py-16 sm:px-8 lg:flex-row lg:items-center lg:gap-20">
    <div class="flex-1">
      <span class="text-[13px] font-bold tracking-[0.14em] text-urgency"
        >ERROR 404</span
      >
      <h1
        class="mt-4 text-pretty text-4xl font-bold leading-[1.12] tracking-tight text-primary sm:text-5xl"
      >
        Esta página no está en cámara.
      </h1>
      <p class="mt-5 max-w-[460px] text-base leading-relaxed text-muted">
        El link que seguiste no existe o el producto ya no está publicado. Probá
        buscarlo de nuevo.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/"
          class="inline-flex h-[52px] items-center justify-center rounded-full bg-primary px-8 text-[15px] font-semibold text-white"
          >Ir al inicio</a
        >
        <a
          href="https://wa.me/541126039243"
          target="_blank"
          rel="noopener"
          class="inline-flex h-[52px] items-center justify-center gap-2.5 rounded-full border-[1.5px] border-gray-300 bg-white px-7 text-[15px] font-semibold text-primary"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#33bf5e"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.4 8.4 0 01-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1121 11.5z"
            ></path>
          </svg>
          Buscamos por vos
        </a>
      </div>

      <div class="mt-11 border-t border-line pt-8">
        <p class="text-sm font-semibold text-ink">O mirá por categoría</p>
        <div class="mt-4 flex flex-wrap gap-2.5">
          {
            categories.map((c) => (
              <a
                href={`/category/${c.path}`}
                class="inline-flex h-10 items-center rounded-full border-[1.5px] border-line bg-white px-4 text-[13px] text-ink transition-colors hover:border-primary"
              >
                {c.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="flex h-72 w-full shrink-0 items-center justify-center rounded-3xl border border-line bg-white lg:h-96 lg:w-96"
    >
      <svg
        width="220"
        height="220"
        viewBox="0 0 120 120"
        fill="none"
        aria-hidden="true"
      >
        <rect
          x="22"
          y="30"
          width="62"
          height="30"
          rx="15"
          fill="#ffffff"
          stroke="#d9d4e3"
          stroke-width="2"></rect>
        <circle cx="37" cy="45" r="9.5" fill="#f4f2f8" stroke="#d9d4e3" stroke-width="2"
        ></circle>
        <path
          d="M32 40l10 10M42 40l-10 10"
          stroke="#c9c2d8"
          stroke-width="2.2"
          stroke-linecap="round"></path>
        <path
          d="M84 40v10M60 60v14"
          stroke="#d9d4e3"
          stroke-width="2.5"
          stroke-linecap="round"></path>
        <path
          d="M44 96c0-8 7-13 16-13s16 5 16 13z"
          fill="#ffffff"
          stroke="#d9d4e3"
          stroke-width="2"
          stroke-linejoin="round"></path>
      </svg>
    </div>
  </main>
</Layout>
