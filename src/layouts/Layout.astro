---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackButton from "@/components/Buttons/BackButton";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Marquee from "@/components/Marquee.astro";
import MetaPixel from "@/components/MetaPixel.astro";
import SchemaOrg from "@/components/SchemaOrg.astro";
import { GA4_MEASUREMENT_ID } from "@/services/const";

interface Props {
  title: string;
  description?: string;
  /** Absoluta. Por defecto la imagen genérica de la tienda. */
  image?: string;
  type?: "website" | "product" | "article";
  /** Fuerza noindex. Si no se pasa, se deduce de NOINDEX_PATHS. */
  noindex?: boolean;
  /** Canónica explícita. Por defecto la ruta actual sin query ni barra final. */
  canonical?: string | URL;
}

const {
  title,
  description,
  image,
  type = "website",
  noindex,
  canonical,
} = Astro.props;
const { url } = Astro;
const BASE_URL = import.meta.env.PUBLIC_ASSETS_URL;

// El dominio productivo es www: vigi.com.ar redirige 308 a www.vigi.com.ar.
// Sale de `site` en astro.config para no tener el host escrito en dos lados.
const SITE = Astro.site ?? new URL("https://www.vigi.com.ar");

const DEFAULT_DESCRIPTION =
  "Cámaras de seguridad, alarmas y kits de videovigilancia para tu casa o negocio, al mejor precio de Argentina. Envíos a todo el país y pago en cuotas.";

/*
  Rutas que no tienen por qué estar en Google. Son de tres tipos: privadas
  (perfil, carrito, datos de envío), transaccionales de un solo uso (pagos,
  recuperar contraseña, baja de novedades) y resultados de búsqueda, que
  generan infinitas URLs con el mismo contenido.

  `noindex, follow` y no `noindex, nofollow`: queremos que el robot no las
  indexe pero que siga los links que salen de ellas hacia el catálogo.
*/
const NOINDEX_PATHS = [
  "/login",
  "/register",
  "/profile",
  "/cart",
  "/datos",
  "/buscar",
  "/baja",
  "/forgot-password",
  "/new-password",
  "/email-success",
  "/payment",
  "/404",
];

const path = url.pathname.replace(/\/+$/, "") || "/";
const isPrivate = NOINDEX_PATHS.some(
  (p) => path === p || path.startsWith(`${p}/`),
);
const robots = (noindex ?? isPrivate) ? "noindex, follow" : "index, follow";

// Sin query string: /category/exterior?page=2&order=price y
// /category/exterior son la misma página para Google salvo que la página lo
// diga. Las que sí necesitan distinguirse pasan `canonical` a mano.
const canonicalUrl = canonical
  ? new URL(canonical, SITE)
  : new URL(path, SITE);

const metaDescription = description ?? DEFAULT_DESCRIPTION;
const ogImage = image ?? `${BASE_URL}/assets/og.png`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl.href} />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}/assets/vigi_white.svg`} />
    <meta name="theme-color" content="#1E053F" />

    {/*
      La etiqueta `keywords` se fue: Google la ignora desde 2009 y lo único que
      hacía era publicar la lista de términos a los que le apuntamos.
    */}
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="kgvRTZHibC8c4TD_HTW9cPCX3xR34UdwQDF5SpnQswU" />
    {/*
      Verificación del dominio en Meta Business (portafolio "Vigi cam", dominio
      vigi.com.ar, id 1589517809344266). Sin esto no se puede configurar la
      prioridad de eventos para tráfico de iOS, que es donde el píxel más pierde.

      Tiene que quedar en el <head> renderizado en el servidor: Meta no lo
      encuentra si lo inyecta JavaScript después de cargar la página.
    */}
    <meta name="facebook-domain-verification" content="3zgcr3426cbwrbq6zpv6s1bjw14r5u" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-MQJGMW6G");
    </script>
    <!-- End Google Tag Manager -->
     <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17302456620">
    </script>
    <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-17302456620');

      /*
        GA4 comparte el mismo gtag.js que ya carga Google Ads: es un `config`
        más, no otro script. Si GA4_MEASUREMENT_ID está vacío no se configura
        nada y la tienda queda como antes.

        `send_page_view: false` y el page_view a mano son por el ClientRouter:
        con las transiciones de Astro la navegación no recarga la página, así
        que el page_view automático solo contaría la primera pantalla y todo
        el resto de la visita se perdería.
      */
      if (GA4_MEASUREMENT_ID) {
        gtag('config', GA4_MEASUREMENT_ID, { send_page_view: false });

        var ultima = '';

        var enviarVista = function () {
          // Dedupe por URL. `astro:page-load` dispara también en la carga
          // inicial, así que sin esto la primera pantalla se contaría dos
          // veces; y llamarla a mano acá cubre el caso de que el evento no
          // llegue nunca, que es cuando se perderían todas las vistas.
          if (window.location.href === ultima) return;
          ultima = window.location.href;

          gtag('event', 'page_view', {
            page_location: window.location.href,
            page_title: document.title,
          });
        };

        enviarVista();
        document.addEventListener('astro:page-load', enviarVista);
      }
    </script>

    {/*
      `property` y no `name`. Open Graph está definido sobre RDFa, que usa
      `property`; Facebook, WhatsApp e Instagram no leen `name="og:*"` y caían
      al fallback (título del <title> y primera imagen que encontraran en el
      HTML, que acá es el logo del header). Por eso los links compartidos de la
      tienda salían sin foto del producto.
    */}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="VIGI" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <MetaPixel />
    <SchemaOrg />

    <ClientRouter />
    <SpeedInsights />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MQJGMW6G" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {
		url.pathname == "/" && <Marquee />
	}
    <Header render={url.pathname != "/login" && url.pathname !== "/register" && true} />
    {
		url.pathname !== "/" && url.pathname !== "/login" && !url.pathname.includes("payment") && <BackButton client:idle />
    }
    <slot />
    <Footer />
  <script>
    // Sin atributos extra: cualquier atributo propio hace que Astro trate el
    // script como inline y lo copie sin transpilar, y los genéricos de TS
    // rompen la sintaxis en el navegador.
    const initModals = () => {
      document.querySelectorAll("dialog").forEach((dialog) => {
        if (dialog.dataset.modalReady) return;
        dialog.dataset.modalReady = "1";

        dialog.querySelectorAll(".close_btn").forEach((btn) => {
          btn.addEventListener("click", () => dialog.close());
        });

        // Clic en el fondo: <dialog> no lo cierra solo.
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });
      });
    };

    initModals();
    document.addEventListener("astro:page-load", initModals);
  </script>
</body>
</html>
  <style is:global>
    html {
      font-family: "Poppins", system-ui, sans-serif;
      background: #f5f5f7;
      scroll-behavior: smooth;
    }
    /* Antes esto era height:100vh + width:100vw. El 100vw incluye el ancho de
       la barra de scroll, así que la página desbordaba a lo ancho y había un
       overflow-x:hidden tapándolo. */
    body {
      min-height: 100vh;
    }
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }
  </style>
