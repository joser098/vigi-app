---
import { SHOW_WHATSAPP, WHATSAPP_URL } from "@/services/contacto";

const BASE_URL = import.meta.env.PUBLIC_ASSETS_URL;
---

{
  SHOW_WHATSAPP && (
    <a
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener"
      class="fixed bottom-6 right-6 md:bottom-8 xl:right-16 hover:opacity-60 cursor-pointer"
    >
      <div class="flex items-center gap-2" title="Enviar mensaje de WhatsApp">
        <span class="bg-white p-2 rounded-full shadow-lg hidden sm:inline font-bold">
          Contáctanos
        </span>
        <img
          class="w-10 h-auto hover:scale-105"
          src={`${BASE_URL}/assets/ws.webp`}
          alt="Enviar mensaje a WhatsApp"
        />
      </div>
    </a>
  )
}
