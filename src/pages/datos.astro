---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import GuestForm from "@/components/Forms/GuestForm";

// Quien ya tiene sesión tiene estos datos guardados: no hay nada que pedirle.
if (Astro.cookies.has("check")) {
  return Astro.redirect("/cart");
}
---

<Layout title="Tus datos de envío | VIGI">
  <main class="m-auto max-w-[1180px] px-4 py-10 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-lg text-center">
      <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
        ¿A dónde te la mandamos?
      </h1>
      <p class="mt-3 text-[15px] text-muted">
        No hace falta crear una cuenta. Con estos datos alcanza.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <div
        class="rounded-3xl border border-line bg-white p-6 shadow-[0_14px_34px_rgba(30,5,63,0.06)] sm:p-10"
      >
        <GuestForm client:load />
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        ¿Ya tenés cuenta?
        <a href="/login?redirect=/cart" class="font-semibold text-primary hover:underline"
          >Iniciá sesión</a
        >
      </p>
    </div>
  </main>
</Layout>
