---
import Logo from "./Logo.astro";
import SearchInput from "../components/SearchInput";
import { categories } from "@/services/const";

const { render } = Astro.props;
const path = Astro.url.pathname;
---

<header class="border-b border-line bg-white">
  <div
    class="m-auto flex w-full max-w-[1180px] items-center gap-6 px-4 py-4 sm:gap-10 sm:px-8"
  >
    <a href="/" class="shrink-0">
      <Logo />
    </a>

    <div class={`flex-1 ${!render ? "hidden" : "hidden sm:block"}`}>
      <SearchInput client:idle />
    </div>

    <nav class={`flex shrink-0 items-center gap-4 sm:gap-6 ${!render && "hidden"}`}>
      <a
        href="https://wa.me/541126039243"
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 text-[13px] font-medium text-ink hover:text-primary lg:flex"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#33bf5e"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 11.5a8.4 8.4 0 01-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1121 11.5z"
          ></path>
        </svg>
        Asesorate
      </a>

      <a
        href="/profile"
        class="flex items-center gap-2 text-[13px] font-medium text-ink hover:text-primary"
        aria-label="Mi cuenta"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#1e053f"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="3.6"></circle>
          <path d="M4.8 20c0-3.6 3.2-5.6 7.2-5.6s7.2 2 7.2 5.6"></path>
        </svg>
        <span class="hidden sm:inline">Mi cuenta</span>
      </a>

      <a
        href="/cart"
        class="flex h-11 items-center gap-2 rounded-full bg-primary px-4 text-[13px] font-semibold text-white sm:px-5"
      >
        <svg
          width="19"
          height="19"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#ffffff"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 4h2.2l2.3 11h10l2.2-8H6.5"></path>
          <circle cx="9.5" cy="19.5" r="1.4"></circle>
          <circle cx="17" cy="19.5" r="1.4"></circle>
        </svg>
        <span class="hidden sm:inline">Carrito</span>
        <span
          transition:persist
          id="cart_label"
          class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-green_ px-1.5 text-[11px] font-bold text-[#10331d] empty:hidden"
        ></span>
      </a>
    </nav>
  </div>

  <!-- NAVEGACION POR CATEGORIA -->
  <div class={`border-t border-gray-100 ${!render && "hidden"}`}>
    <div
      class="m-auto flex max-w-[1180px] items-center gap-6 overflow-x-auto px-4 py-3 sm:gap-7 sm:px-8"
    >
      <a
        href="/category/promociones"
        class="flex shrink-0 items-center gap-1.5 text-[13px] font-bold text-urgency"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12L13 2z"></path>
        </svg>
        Promociones
      </a>
      {
        categories.map((c) => (
          <a
            href={`/category/${c.path}`}
            class:list={[
              "shrink-0 whitespace-nowrap text-[13px] hover:text-primary",
              path === `/category/${c.path}`
                ? "font-bold text-primary"
                : "text-gray-600",
            ]}
          >
            {c.name}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  import { totalItems } from "@/store/cartStore";

  const cartEle = document.getElementById("cart_label");

  if (cartEle && totalItems.value! > 0)
    cartEle.innerText = totalItems.value?.toString()!;

  totalItems.listen((num) => {
    if (cartEle && num > 0) {
      cartEle.innerText = num.toString();
    } else if (cartEle) {
      cartEle.innerText = "";
    }
  });
</script>
