---
interface Props {
  image_path: string;
  title: string;
}

const { image_path, title } = Astro.props;
---

<a
  class="group flex w-full flex-col items-center justify-center gap-3 rounded-2xl p-3 transition-colors hover:bg-white"
  href={`/category/${title.toLocaleLowerCase()}`}
>
  <img
    class="max-w-20 rounded-xl transition-transform duration-300 group-hover:scale-110 sm:max-w-24"
    src={image_path}
    alt={title}
    width="96"
    height="96"
    loading="lazy"
    decoding="async"
  />
  <span class="text-[13px] text-ink group-hover:font-semibold group-hover:text-primary"
    >{title}</span
  >
</a>
