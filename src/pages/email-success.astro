---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Email verificado con éxito! | VIGI">
  <main class="m-auto flex max-w-[1180px] flex-col items-center px-4 py-16 text-center sm:px-8 sm:py-24">
    <span class="flex size-16 items-center justify-center rounded-full bg-green-soft">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1f8f45" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6L9 17l-5-5"></path>
      </svg>
    </span>
    <h1 class="mt-6 text-2xl font-bold tracking-tight text-primary sm:text-3xl">
      ¡Correo verificado!
    </h1>
    <p class="mt-3 max-w-md text-[15px] leading-relaxed text-muted">
      Ya podés iniciar sesión y empezar a comprar.
    </p>

    <a href="/login" class="mt-8 inline-flex h-[52px] items-center justify-center rounded-full bg-primary px-8 text-[15px] font-semibold text-white">
      Iniciar sesión
    </a>
    <p class="mt-5 text-[13px] text-gray-400">
      Te llevamos solos en <span id="counter" class="font-bold text-ink">8</span> segundos
    </p>
  </main>
</Layout>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const contadorElemento = document.getElementById("counter");
    let segRestantes = 8;

    const intervalo = setInterval(() => {
      segRestantes--;
      updateCounter(segRestantes);
    }, 1000);

    const updateCounter = (seg) => {
      contadorElemento.textContent = seg.toString();

      if (seg <= 0) {
        clearInterval(intervalo);
        window.location.href = "/login"
      }
    };
  });
</script>
