---
import Layout from "@/layouts/Layout.astro";
import ForgotPasswordForm from "@/components/Forms/ForgotPasswordForm";
---

<Layout title="Olvidé mi contraseña | VIGI">
  <main class="m-auto max-w-[1180px] px-4 py-12 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-md text-center">
      <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
        Olvidé mi contraseña
      </h1>
      <p class="mt-3 text-[15px] leading-relaxed text-muted">
        Escribí tu correo y te mandamos los pasos para restablecerla.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-md rounded-3xl border border-line bg-white p-8 shadow-[0_14px_34px_rgba(30,5,63,0.06)] sm:p-10">
      <ForgotPasswordForm client:load />
    </div>

    <p class="mt-6 text-center text-sm text-muted">
      <a href="/login" class="font-semibold text-primary hover:underline">Volver al ingreso</a>
    </p>
  </main>
</Layout>
