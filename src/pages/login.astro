---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import LoginForm from "@/components/Forms/LoginForm";

const session = Astro.cookies.get("check");

if (session) {
  return Astro.redirect("/profile");
}
---

<Layout title="Iniciar sesión | VIGI">
  <main class="m-auto max-w-[1180px] px-4 py-10 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-lg text-center">
      <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
        Entrá a tu cuenta
      </h1>
      <p class="mt-3 text-[15px] text-muted">
        Con la sesión iniciada seguís tus pedidos y la próxima compra te lleva
        dos clics.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-md">
      <div
        class="rounded-3xl border border-line bg-white p-8 shadow-[0_14px_34px_rgba(30,5,63,0.06)] sm:p-10"
      >
        <LoginForm client:load />
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        ¿Todavía no tenés cuenta?
        <a href="/register" class="font-semibold text-primary hover:underline"
          >Creá una</a
        >
      </p>

      <ul class="mt-8 flex flex-col gap-3 border-t border-line pt-6">
        {
          [
            "Seguís tus pedidos y tus compras anteriores",
            "Guardás favoritos y tu dirección",
            "Tus datos viajan cifrados",
          ].map((item) => (
            <li class="flex items-center gap-2.5">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#33bf5e"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6L9 17l-5-5" />
              </svg>
              <span class="text-[13px] text-muted">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>
