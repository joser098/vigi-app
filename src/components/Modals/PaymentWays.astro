---
import MP from "@/components/Icons/MP.astro";
import Mastercard from "../Icons/Mastercard.astro";
import Visa from "../Icons/Visa.astro";
import Amex from "../Icons/Amex.astro";
import Maestro from "../Icons/Maestro.astro";
---

<dialog
  id="pagos_modal"
  class="w-[min(560px,calc(100vw-2rem))] rounded-3xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm"
>
  <header
    class="flex items-center justify-between gap-4 border-b border-line px-6 py-5"
  >
    <h2 class="text-lg font-bold text-primary">Medios de pago</h2>
    <button
      class="close_btn flex size-9 items-center justify-center rounded-full text-gray-400 transition-colors hover:bg-panel hover:text-primary"
      aria-label="Cerrar"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div class="flex flex-col gap-4 px-6 py-6">
    <p class="text-sm leading-relaxed text-muted">
      Aceptamos tarjetas de crédito y débito. En el carrito vas a ver
      <strong class="font-semibold text-ink">dos botones de pago</strong>, uno
      por cada procesador: elegí el que prefieras y completás el pago en su
      propia pantalla.
    </p>

    <div class="rounded-2xl border border-line bg-panel p-5">
      <div class="flex items-center gap-3">
        <MP />
        <span class="text-sm font-bold text-ink">Mercado Pago</span>
      </div>
      <p class="mt-3 text-[13px] leading-relaxed text-muted">
        Pagás con dinero en cuenta o con tarjeta de crédito o débito.
      </p>
      <div class="mt-4 flex items-center gap-4">
        <Mastercard />
        <Visa />
        <Amex />
        <Maestro />
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-panel p-5">
      <span class="text-sm font-bold text-ink">Promociones</span>
      <p class="mt-3 text-[13px] leading-relaxed text-muted">
        El otro procesador con el que trabajamos. También con tarjeta de crédito
        o débito.
      </p>
    </div>

    <p class="text-[12.5px] leading-relaxed text-muted">
      No guardamos los datos de tu tarjeta: los toma el procesador en su propia
      pantalla. ¿Dudas? Escribinos por <a
        class="font-semibold text-primary hover:underline"
        href="https://wa.me/541126039243"
        target="_blank"
        rel="noopener">WhatsApp</a
      >.
    </p>
  </div>

  <footer class="flex justify-end border-t border-line px-6 py-4">
    <button
      class="close_btn h-11 rounded-full bg-primary px-7 text-sm font-semibold text-white"
    >
      Cerrar
    </button>
  </footer>
</dialog>
