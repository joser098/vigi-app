---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "@/components/Forms/RegisterForm";
---

<Layout title="Crea una cuenta | VIGI">
  <main class="m-auto max-w-[1180px] px-4 py-10 sm:px-8 sm:py-16">
    <div class="mx-auto max-w-lg text-center">
      <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
        Creá tu cuenta
      </h1>
      <p class="mt-3 text-[15px] text-muted">
        Es un minuto y después comprás sin volver a cargar tus datos.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <div
        class="rounded-3xl border border-line bg-white p-6 shadow-[0_14px_34px_rgba(30,5,63,0.06)] sm:p-10"
      >
        <RegisterForm client:load />
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        ¿Ya tenés cuenta?
        <a href="/login" class="font-semibold text-primary hover:underline">Iniciá sesión</a>
      </p>
    </div>
  </main>
</Layout>
