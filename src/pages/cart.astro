---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { getCartData } from "../services/fetchData";
import { type CartItem } from "../services/types";
import Sad from "../components/Icons/Sad.astro";
import DeleteItemButton from "../components/Buttons/DeleteItemButton";
import OrderResume from "../components/OrderResume";
import QuantitySelect from "@/components/Buttons/QuantitySelect";
import AddCartButton from "@/components/Buttons/AddCartButton";
import Truck from "@/components/Icons/Truck.astro";
import { FREE_SHIPPING_LABEL } from "@/services/const";

let cart;
if (Astro.cookies.has("check")) {
  const token = Astro.cookies.get("check");
  if (token?.value) {
    cart = await getCartData(token.value);
  } else {
    cart = { items: [], products_total: 0, amount_to_pay: 0 };
  }
} else {
  return Astro.redirect("/login");
}

const money = (n: number) =>
  n.toLocaleString("es-AR", {
    style: "currency",
    currency: "ARS",
    minimumFractionDigits: 0,
  });

const steps = [
  { n: 1, label: "Carrito", current: true },
  { n: 2, label: "Envío", current: false },
  { n: 3, label: "Pago", current: false },
];
---

<Layout title={`(${cart.products_total}) Carrito de compras | VIGI`}>
  <main class="m-auto max-w-[1180px] p-4 sm:px-8">
    <!-- PASOS -->
    <nav class="flex items-center justify-center gap-3 py-4 sm:gap-4">
      {
        steps.map((step, i) => (
          <>
            {i > 0 && <span class="h-px w-6 bg-gray-300 sm:w-10" />}
            <span class="flex items-center gap-2">
              <span
                class:list={[
                  "flex size-6 items-center justify-center rounded-full text-[11.5px] font-bold",
                  step.current
                    ? "bg-primary text-white"
                    : "bg-gray-200 text-gray-500",
                ]}
              >
                {step.n}
              </span>
              <span
                class:list={[
                  "text-[13px]",
                  step.current ? "font-semibold text-primary" : "text-gray-500",
                ]}
              >
                {step.label}
              </span>
            </span>
          </>
        ))
      }
    </nav>

    <div class="mb-6 mt-2 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-primary sm:text-3xl">
          Tu carrito
        </h1>
        <p class="mt-2 text-sm text-muted">
          {cart.products_total}
          {cart.products_total === 1 ? " producto" : " productos"} · ya casi es
          tuyo.
        </p>
      </div>
      <a
        href="/"
        class="text-sm font-semibold text-primary hover:underline">Seguir comprando</a
      >
    </div>

    {
      cart.items.length > 0 && (
        <div class="mb-6 flex items-center gap-3.5 rounded-2xl border border-[#c6ecd5] bg-green-soft px-5 py-4">
          <Truck height="22" width="22" color="#1f8f45" />
          <span class="text-sm font-semibold text-green-ink">
            Envío gratis en CABA y en compras desde {FREE_SHIPPING_LABEL} a todo
            el país. Abajo vas a ver el costo exacto según tu dirección.
          </span>
        </div>
      )
    }

    <section class="flex flex-col justify-between gap-8 md:flex-row md:gap-8">
      <article class="w-full">
        <div
          id="row_contain"
          data-items={cart.items.length}
          class="overflow-hidden rounded-2xl border border-line bg-white"
        >
          {
            cart.items.length > 0 ? (
              <>
                {cart.items.map((product: CartItem, index: number) => (
                  <div class="flex flex-col gap-4 border-b border-line p-4 last:border-b-0 sm:flex-row sm:items-center sm:gap-5 sm:p-5">
                    <div class="flex items-center gap-4">
                      <img
                        src={product.picture_url}
                        alt={product.title}
                        class="size-20 shrink-0 rounded-xl bg-panel object-contain p-2 sm:size-24"
                        width="96"
                        height="96"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="min-w-0 flex-1 sm:hidden">
                        <h2 class="text-sm font-bold text-primary">
                          {product.title}
                        </h2>
                        <p class="mt-1 text-lg font-bold text-ink">
                          {money(product.unit_price)}
                        </p>
                      </div>
                    </div>

                    <div class="hidden min-w-0 flex-1 sm:block">
                      <h2 class="text-base font-bold text-primary">
                        {product.title}
                      </h2>
                      <p class="mt-1 text-[13px] text-muted">
                        {money(product.unit_price)} por unidad
                      </p>
                    </div>

                    <div class="flex items-center justify-between gap-4 sm:justify-end">
                      <div>
                        <div id={`selectQ_${index}`}>
                          <QuantitySelect
                            client:load
                            id={product.id}
                            inherit_value={product.quantity}
                            padding="p-1"
                          />
                        </div>
                        <div id={`addBtn_${index}`} class="mt-2 hidden">
                          <AddCartButton
                            client:load
                            product={product}
                            buttonLabel="Actualizar"
                            padding="p-1"
                          />
                        </div>
                      </div>

                      <p class="w-28 text-right text-lg font-bold text-ink">
                        {money(product.quantity * product.unit_price)}
                      </p>

                      <DeleteItemButton client:load product_id={product.id} />
                    </div>
                  </div>
                ))}
                <div class="flex justify-end px-5 py-3">
                  <button
                    id="empty"
                    class="text-xs text-gray-500 hover:text-primary hover:underline"
                  >
                    Vaciar carrito
                  </button>
                </div>
              </>
            ) : (
              <div class="flex flex-col items-center justify-center gap-3 p-12">
                <Sad />
                <span class="text-center text-muted">
                  Tu carrito está vacío por el momento.
                </span>
                <a
                  href="/"
                  class="mt-2 rounded-full bg-primary px-7 py-3 text-sm font-semibold text-white"
                >
                  Ver productos
                </a>
              </div>
            )
          }
        </div>
      </article>

      <OrderResume client:load cart={cart} />
    </section>
  </main>
</Layout>

<script>
  import { emptyCartFn } from "@/store/cartStore";
  import { navigate } from "astro:transitions/client";

  document?.addEventListener("astro:page-load", () => {
    const items_contain = document.getElementById("row_contain");
    const itemsTotal = items_contain?.getAttribute("data-items");
    const total = itemsTotal && parseInt(itemsTotal);

    const empty_btn = document.getElementById("empty");

    if (total) {
      for (let i = 0; i < total; i++) {
        const div = document.getElementById(`selectQ_${i}`);
        const btn = document.getElementById(`addBtn_${i}`);

        div?.addEventListener("click", () => {
          btn?.classList.remove("hidden");
        });
      }
    }

    empty_btn &&
      empty_btn?.addEventListener("click", async () => {
        const response = await emptyCartFn();

        if (response.success) {
          navigate("/cart");
        }
      });
  });
</script>
