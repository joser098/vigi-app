---
import { campaigns } from "@/services/const";

const active = campaigns.filter((c) => c.active);
---

{
  active.length > 0 && (
    <section class="relative" data-campaigns>
      <div class="overflow-hidden rounded-3xl">
        <div class="flex transition-transform duration-700 ease-out" data-campaign-track>
          {active.map((campaign) => (
            <a
              href={campaign.href}
              class="relative flex w-full shrink-0 flex-col justify-center gap-5 overflow-hidden bg-linear-to-br from-[#2c0b5e] to-primary px-7 py-8 sm:h-[200px] sm:flex-row sm:items-center sm:justify-between sm:px-14 sm:py-0"
            >
              <span
                class="pointer-events-none absolute -top-16 right-32 hidden h-64 w-64 rounded-full bg-white/5 sm:block"
                aria-hidden="true"
              />
              <span class="relative">
                <span class="inline-flex h-7 items-center rounded-md bg-[#f0b429] px-3 text-[11px] font-bold tracking-[0.14em] text-[#3a2600]">
                  {campaign.tag}
                </span>
                <span class="mt-3.5 block text-pretty text-2xl font-bold leading-[1.1] tracking-tight text-white sm:text-[34px]">
                  {campaign.title}
                </span>
                <span class="mt-2.5 block text-sm text-violet-200">
                  {campaign.subtitle}
                </span>
              </span>
              <span class="relative inline-flex h-[52px] shrink-0 items-center justify-center rounded-full bg-white px-8 text-[15px] font-bold text-primary">
                Ver la campaña
              </span>
            </a>
          ))}
        </div>
      </div>

      {active.length > 1 && (
        <div class="mt-4 flex items-center justify-center gap-2">
          {active.map((campaign, index) => (
            <button
              type="button"
              data-campaign-dot={index}
              aria-label={`Ir a ${campaign.tag}`}
              aria-current={index === 0 ? "true" : "false"}
              class="h-[5px] w-[5px] rounded-full bg-gray-300 transition-all aria-[current=true]:w-6 aria-[current=true]:bg-primary"
            />
          ))}
        </div>
      )}
    </section>
  )
}

<script>
  const init = () => {
    const root = document.querySelector<HTMLElement>("[data-campaigns]");
    const track = root?.querySelector<HTMLElement>("[data-campaign-track]");
    if (!root || !track) return;

    const dots = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-campaign-dot]"),
    ];
    if (dots.length < 2) return;

    let current = 0;
    const go = (index: number) => {
      current = index;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", String(i === index)),
      );
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => go(index)));

    // Respetamos a quien pidió menos movimiento en el sistema.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    window.setInterval(() => go((current + 1) % dots.length), 6000);
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
