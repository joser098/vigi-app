---
const modalities = [
  {
    title: "AMBA · entrega rápida",
    body: "Si finalizás la compra y el pago se aprueba antes de las 14:00, despachamos el pedido el mismo día. Después de esa hora, sale al siguiente día hábil. Lo recibís en un máximo de 4 días hábiles.",
  },
  {
    title: "Todo el país · entrega eficiente",
    body: "Mismo corte de las 14:00 para el despacho. El plazo de entrega al resto del país es de 8 a 12 días hábiles desde la confirmación de la compra.",
  },
  {
    title: "Retiro en oficina",
    body: "Podés retirar en nuestra oficina de Caballito (CABA) a partir de las 24 h hábiles de aprobado el pago. Lo retira únicamente el titular de la compra con DNI. Te avisamos por mail cuando esté listo.",
  },
];

const tips = [
  "Sumá todos los artículos al mismo carrito para recibirlos en un solo envío.",
  "Tené el DNI a mano al momento de la entrega o el retiro.",
  "Revisá el estado y que el pedido coincida antes de firmar el remito.",
];
---

<dialog
  id="entregas_modal"
  class="w-[min(600px,calc(100vw-2rem))] rounded-3xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm"
>
  <header class="flex items-center justify-between gap-4 border-b border-line px-6 py-5">
    <h2 class="text-lg font-bold text-primary">Formas de entrega</h2>
    <button class="close_btn flex size-9 items-center justify-center rounded-full text-gray-400 transition-colors hover:bg-panel hover:text-primary" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div class="max-h-[70vh] overflow-y-auto px-6 py-6">
    <div class="mb-5 flex items-center gap-3 rounded-2xl border border-[#c6ecd5] bg-green-soft px-5 py-4">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1f8f45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"></path>
        <circle cx="7" cy="18.5" r="1.6"></circle>
        <circle cx="17.5" cy="18.5" r="1.6"></circle>
      </svg>
      <span class="text-sm font-semibold text-green-ink">Entrega en 24 h sin costo adicional en CABA.</span>
    </div>

    <ul class="flex flex-col gap-4">
      {
        modalities.map((m) => (
          <li class="rounded-2xl border border-line p-5">
            <h3 class="text-sm font-bold text-primary">{m.title}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-muted">{m.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 border-t border-line pt-5">
      <h3 class="text-xs font-bold uppercase tracking-[0.1em] text-gray-400">Recomendaciones</h3>
      <ul class="mt-4 flex flex-col gap-2.5">
        {
          tips.map((tip) => (
            <li class="flex items-start gap-2.5">
              <svg class="mt-0.5 shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#33bf5e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              <span class="text-[13px] leading-relaxed text-muted">{tip}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-[12px] italic text-gray-400">Los costos de envío están sujetos a la región.</p>
    </div>
  </div>

  <footer class="flex justify-end border-t border-line px-6 py-4">
    <button class="close_btn h-11 rounded-full bg-primary px-7 text-sm font-semibold text-white">Cerrar</button>
  </footer>
</dialog>
