---
import { footerData } from "../services/const";
import DataFiscal from "./DataFiscal.astro";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line bg-white">
  <div class="m-auto max-w-[1180px] px-4 py-12 sm:px-8">
    <div class="flex flex-col justify-between gap-10 lg:flex-row lg:gap-16">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-[13px] leading-relaxed text-muted">
          Tienda online de artículos de seguridad. Caballito, Capital Federal,
          Argentina.
        </p>
        <a
          href="https://wa.me/541126039243"
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex h-11 items-center gap-2.5 rounded-full border-[1.5px] border-gray-300 px-5 text-[13px] font-semibold text-primary transition-colors hover:border-primary"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#33bf5e"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.4 8.4 0 01-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1121 11.5z"
            ></path>
          </svg>
          11 2603 9243
        </a>
      </div>

      <div class="grid flex-1 grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-6">
        {
          footerData.map((item) => (
            <div>
              <h2 class="text-[13px] font-bold text-primary">{item.title}</h2>
              <ul class="mt-4 flex flex-col gap-2.5">
                {item.redirects.map((link) => (
                  <li>
                    <a
                      class="text-[12.5px] text-muted hover:text-primary hover:underline"
                      href={link.url}
                      target={link.url.includes("https") ? "_blank" : "_self"}
                      rel={link.url.includes("https") ? "noopener" : undefined}
                    >
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <h2 class="text-[13px] font-bold text-primary">Navegar</h2>
          <ul class="mt-4 flex flex-col gap-2.5">
            <li>
              <a
                href="/"
                class="text-[12.5px] text-muted hover:text-primary hover:underline"
                >Inicio</a
              >
            </li>
            <li>
              <a
                href="/cart"
                class="text-[12.5px] text-muted hover:text-primary hover:underline"
                >Carrito</a
              >
            </li>
            <li>
              <a
                href="/profile"
                class="text-[12.5px] text-muted hover:text-primary hover:underline"
                >Perfil</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-6 border-t border-line pt-7 sm:flex-row sm:items-center"
    >
      <div class="flex items-center gap-3">
        <DataFiscal />
        <div class="border-l border-line pl-3">
          <span class="block text-[11.5px] text-gray-400"
            >Copyright © {year} Vigi</span
          >
          <span class="block text-[11.5px] text-gray-400"
            >Caballito, Capital Federal. Argentina</span
          >
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <span class="text-[11.5px] text-gray-400">Pagá con</span>
        <span class="text-[12px] font-bold text-gray-300">VISA</span>
        <span class="text-[12px] font-bold text-gray-300">Mastercard</span>
        <span class="text-[12px] font-bold text-gray-300">Amex</span>
        <span class="text-[12px] font-bold text-gray-300">Mercado Pago</span>
      </div>
    </div>
  </div>
</footer>
