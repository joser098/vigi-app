---
import { CONTACT_TARGET, CONTACT_URL } from "@/services/contacto";
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { fetchData } from "../../services/fetchData";
import type { Product } from "../../services/types";
import Truck from "@/components/Icons/Truck.astro";
import BuyButton from "@/components/Buttons/BuyButton";
import AddCartButton from "@/components/Buttons/AddCartButton";
import QuantitySelect from "@/components/Buttons/QuantitySelect";
import Favorite from "@/components/Icons/Favorite";
import CardsCarrusel from "@/components/CardsCarrusel.astro";
import PaymentWays from "@/components/Modals/PaymentWays.astro";
import MP from "@/components/Icons/MP.astro";
import Mastercard from "@/components/Icons/Mastercard.astro";
import Visa from "@/components/Icons/Visa.astro";
import ShippingWays from "@/components/Modals/ShippingWays.astro";
import Gallery from "@/components/Gallery.astro";
import ShipBadge from "@/components/ShipBadge.astro";
import {
  categories,
  FREE_SHIPPING_MIN_PURCHASE,
  PRODUCT_CATEGORY_LABEL,
} from "@/services/const";

const BASE_URL = import.meta.env.PUBLIC_ASSETS_URL;

// Ruta con parámetro "rest" y no `[model]`: siete modelos de la línea solar
// llevan una barra adentro del nombre —"HB8 2K+ (4MP) P/S"— y con un solo
// segmento esa barra partía la ruta y devolvía 404 desde cualquier link del
// sitio. Así entra completa, escapada o no.
//
// El precio de aceptar las dos formas es que llegan decodificadas distinto: con
// la barra cruda Astro entrega "HB8 2K+ (4MP) P/S", y con la barra escapada
// deja "HB8 2K%2B (4MP) P%2FS". decodeURIComponent las junta en la misma. Va
// con try porque un `%` suelto en la URL lo hace tirar excepción.
const crudo = Astro.params.model ?? "";
let model = crudo;
try {
  model = decodeURIComponent(crudo);
} catch {
  model = crudo;
}

// Sin modelo, o con un modelo que la API no conoce, antes esto reventaba con
// un 500 y cuerpo vacío: `product` venía undefined y la línea de abajo leía
// `product.provider`. Para tráfico pago un 500 es peor que un 404, porque no
// muestra ni la página de "no existe" ni las categorías.
const product = model
  ? ((await fetchData(`getProduct?model=${encodeURIComponent(model)}`)) as Product)
  : undefined;

// redirect y no rewrite: `404.astro` es estática y Astro prohíbe reescribir una
// ruta prerenderizada desde una on-demand.
if (!product?.model) {
  return Astro.redirect("/404");
}

const similarProducts = await fetchData(
  `getSimilarProducts?provider=${product.provider}&category=${product.category}`,
);

const money = (n: number) =>
  n.toLocaleString("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  });

// La descripción viene separada por " | ", que es exactamente lo que ya está
// cargado en details.specs. Usamos el array y dejamos el texto plano de reserva.
const specs: string[] =
  (product.details as any)?.specs ??
  product.description?.split("|").map((s) => s.trim()).filter(Boolean) ??
  [];

// --- SEO ---------------------------------------------------------------------

const SITE = Astro.site ?? new URL("https://www.vigi.com.ar");
const canonical = new URL(
  `/product/${encodeURIComponent(product.model)}`,
  SITE,
).href;

// El título de la pestaña era `${model} | VIGI`: solo el código de fábrica
// ("DS-2CD1043G0-I | VIGI"), que nadie busca. Con marca y categoría adelante
// el mismo resultado matchea "camara hikvision exterior" además del modelo.
const categoryLabel =
  PRODUCT_CATEGORY_LABEL[product.category] ?? product.category;

// Solo las ocho de la navegación tienen página propia listada en el sitemap.
// `camaras`, `grabadores`, `cerraduras` y `redes` son valores del campo
// `category` sin entrada en el menú, así que no sirven como escalón de la
// miga de pan: apuntarían a una URL que no queremos posicionar.
const navCategory = categories.find((c) => c.path === product.category);

const seoTitle =
  `${product.provider} ${product.model} — ${categoryLabel} | VIGI`.slice(0, 70);

// Las specs ya están escritas para el cliente, así que la descripción sale de
// ahí en vez de repetir la genérica de la tienda en 646 fichas iguales.
const seoDescription = [
  `${product.provider} ${product.model} a ${money(product.price)}.`,
  specs.slice(0, 3).join(", ") + ".",
  "Envío a todo el país y pago en cuotas.",
]
  .join(" ")
  .replace(/\s+/g, " ")
  .slice(0, 160);

const galleryImages = Array.from(
  { length: Math.max(1, product.gallery) },
  (_, i) =>
    `${BASE_URL}/gallery/${encodeURIComponent(product.model).replace(/%20/g, "+")}/${i}.png`,
);

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${canonical}#product`,
  name: `${product.provider} ${product.model}`,
  sku: product.model,
  mpn: product.model,
  description: product.description?.replace(/\s*\|\s*/g, ". ") ?? seoDescription,
  image: galleryImages,
  brand: { "@type": "Brand", name: product.provider },
  category: categoryLabel,
  offers: {
    "@type": "Offer",
    url: canonical,
    priceCurrency: "ARS",
    price: product.price,
    /*
      Sin `priceValidUntil` Google avisa en Search Console, pero poner una
      fecha corta es peor: cuando pasa, la oferta se marca vencida y el
      producto deja de mostrar precio en resultados. Un año es lo que
      recomienda la propia documentación cuando el precio no tiene vencimiento
      real.
    */
    priceValidUntil: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000)
      .toISOString()
      .slice(0, 10),
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    seller: { "@id": new URL("#organization", SITE).href },
    /*
      El envío solo se declara cuando es gratis, o sea cuando el producto solo
      ya pasa el mínimo. Por debajo el costo lo calcula el cotizador según el
      destino y no hay un número que se pueda afirmar acá: declarar uno
      inventado es peor que no declarar nada, porque Google lo muestra en la
      ficha y el cliente ve otro en el carrito.
    */
    ...(product.price >= FREE_SHIPPING_MIN_PURCHASE
      ? {
          shippingDetails: {
            "@type": "OfferShippingDetails",
            shippingDestination: {
              "@type": "DefinedRegion",
              addressCountry: "AR",
            },
            shippingRate: {
              "@type": "MonetaryAmount",
              currency: "ARS",
              value: 0,
            },
          },
        }
      : {}),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: SITE.href,
    },
    ...(navCategory
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: navCategory.name,
            item: new URL(`/category/${navCategory.path}`, SITE).href,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: navCategory ? 3 : 2,
      name: `${product.provider} ${product.model}`,
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={galleryImages[0]}
  type="product"
  canonical={canonical}
>
  <!-- BARRA DE COMPRA FIJA -->
  <div
    id="sticky_buy"
    class="pointer-events-none fixed inset-x-0 top-0 z-30 -translate-y-full border-b border-line bg-white/95 opacity-0 shadow-[0_6px_20px_rgba(30,5,63,0.06)] backdrop-blur transition-all duration-300"
  >
    <div
      class="m-auto flex max-w-[1180px] items-center gap-5 px-4 py-3 sm:px-8"
    >
      <img
        class="hidden size-12 shrink-0 rounded-xl bg-panel object-contain p-1.5 sm:block"
        src={product.thumbnail}
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
      />
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-bold text-primary">
          {product.provider} {product.model}
        </p>
        <p class="text-xs font-semibold text-green_">
          Envío gratis · Llega mañana en CABA
        </p>
      </div>
      <div class="hidden text-right sm:block">
        <p class="text-xl font-bold text-ink">{money(product.price)}</p>
      </div>
      <a
        href="#comprar"
        class="shrink-0 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white"
        >Comprar</a
      >
    </div>
  </div>

  <main class="m-auto max-w-[1180px] p-4 sm:px-8">
    <!-- MIGA -->
    <nav class="flex items-center gap-2 py-3 text-xs text-gray-400">
      <a href="/" class="hover:underline">Inicio</a>
      <span>/</span>
      <a href={`/category/${product.category}`} class="capitalize hover:underline"
        >{product.category}</a
      >
      <span>/</span>
      <span class="text-ink">{product.model}</span>
    </nav>

    <section class="flex flex-col gap-8 sm:flex-row-reverse sm:gap-12">
      <!-- GALERIA -->
      <article class="relative mb-3 flex w-full justify-center sm:mb-0">
        {
          product.price_diferred && (
            <div class="gradient_violet absolute left-0 top-0 z-10 flex flex-col items-center rounded-xl px-3.5 py-2">
              <span class="text-[10px] leading-tight text-white">Ahorrás</span>
              <span class="text-[15px] font-bold leading-tight text-white">
                {money(product.price_diferred)}
              </span>
            </div>
          )
        }
        <Gallery model={product.model} gallery_images_total={product.gallery} />
      </article>

      <!-- CAJA DE COMPRA -->
      <article class="flex w-full flex-col sm:w-1/2">
        <img
          class="mb-4 h-6 self-start object-contain"
          src={`${BASE_URL}/logos/${product.provider}.png`}
          alt={product.provider}
          height="24"
          loading="lazy"
          decoding="async"
        />

        <div class="mb-4 flex items-start justify-between gap-4">
          {/*
            Con la marca adelante, igual que la barra de compra fija. El h1 es
            la señal más fuerte de de qué trata la página y decía solo el
            código de fábrica: "DS-2CD1043G0-I" no lo busca nadie,
            "Hikvision DS-2CD1043G0-I" sí.
          */}
          <h1 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">
            {product.provider} {product.model}
          </h1>
          <span class="transition-transform hover:scale-110 hover:cursor-pointer">
            <Favorite client:idle product={product} />
          </span>
        </div>

        {
          product.title && (
            <p class="mb-6 text-pretty text-[15px] leading-relaxed text-muted">
              {product.title}
            </p>
          )
        }

        <!-- PRECIO -->
        <div
          id="comprar"
          class="scroll-mt-24 rounded-2xl border border-line bg-white p-6 shadow-[0_14px_34px_rgba(30,5,63,0.06)]"
        >
          {
            product.price_original && (
              <div class="mb-2 flex items-center gap-3">
                <span class="text-sm text-gray-400 line-through">
                  {money(product.price_original)}
                </span>
                {product.discount > 0 && (
                  <span class="inline-flex h-6 items-center rounded-full bg-green_ px-2.5 text-[11.5px] font-bold text-[#10331d]">
                    {product.discount}% OFF
                  </span>
                )}
              </div>
            )
          }
          <p class="text-4xl font-bold tracking-tight text-ink">
            {money(product.price)}
          </p>

          <div class="mt-5">
            <QuantitySelect client:load id={product.id} inherit_value={0} padding="p-3" />
          </div>

          <div class="mt-4 grid gap-3">
            <BuyButton client:load product={product} />
            <AddCartButton
              client:load
              product={product}
              buttonLabel="Agregar al carrito"
              padding="p-3"
            />
          </div>

          <!-- CONFIANZA -->
          <ul class="mt-6 flex flex-col gap-3 border-t border-line pt-5">
            <li class="flex items-center gap-2.5">
              <Truck height="18" width="18" color="#33BF5E" />
              <span class="text-[13.5px] text-ink"
                ><strong class="font-semibold">Envíos a todo el país</strong> ·
                gratis en CABA</span
              >
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#33bf5e"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3l7.5 3v6c0 4.4-3.1 8.1-7.5 9.3C7.6 20.1 4.5 16.4 4.5 12V6L12 3z"
                ></path>
                <path d="M9.2 12.2l2 2 3.6-3.9"></path>
              </svg>
              <span class="text-[13.5px] text-ink"
                ><strong class="font-semibold">Garantía oficial</strong> · 6 a 24
                meses según la marca</span
              >
            </li>
            <li class="flex items-center gap-2.5">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#33bf5e"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 11.5a8.4 8.4 0 01-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1121 11.5z"
                ></path>
              </svg>
              <span class="text-[13.5px] text-ink"
                >¿Dudas antes de comprar? <a
                  href={CONTACT_URL}
                  target={CONTACT_TARGET}
                  rel="noopener"
                  class="font-semibold underline">Escribinos</a
                ></span
              >
            </li>
          </ul>

          <div class="mt-5 border-t border-line pt-5">
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs text-muted">Medios de pago</span>
              <button
                id="pagos_modal_btn"
                class="text-xs text-primary hover:underline">Ver todos</button
              >
            </div>
            <div class="mt-2 flex max-h-6 items-center justify-start">
              <MP />
              <Visa />
              <Mastercard />
            </div>
          </div>
        </div>

        <!-- ENTREGA -->
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
          <ShipBadge />
          <button
            id="entregas_modal_btn"
            class="text-xs text-primary hover:underline">Formas de entrega</button
          >
        </div>
      </article>
    </section>

    <!-- CARACTERISTICAS -->
    {
      specs.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-bold tracking-tight text-primary">
            Características
          </h2>
          <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
            {specs.map((spec) => (
              <li class="flex items-center gap-3 bg-white px-5 py-3.5">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#33bf5e"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span class="text-sm text-ink">{spec}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- SIMILARES -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight text-primary">
        Otras opciones similares
      </h2>
      <p class="mt-2.5 text-sm text-muted">
        Encontrá la que más se ajuste a lo que necesitás.
      </p>
      <div class="mt-8">
        <CardsCarrusel products={similarProducts} />
      </div>
    </section>

    <PaymentWays />
    <ShippingWays />
  </main>
  {/*
    Datos estructurados de la ficha. Van en el cuerpo y no en el <head> porque
    dependen de datos que se resuelven en la página; Google los lee igual.

    Es lo que habilita el resultado enriquecido: precio, disponibilidad y marca
    debajo del título en la búsqueda, y la entrada del producto en la pestaña
    Shopping sin pagar por el click.
  */}
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(productSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</Layout>

{/*
  ViewContent: la señal con la que Meta aprende qué producto le interesa a cada
  persona mientras las compras todavía son pocas. Va inline y no en un
  componente de React porque no hay ningún React montado en esta parte de la
  página, y el <ClientRouter /> vuelve a ejecutar este script cuando se navega
  a otro producto sin recargar.
*/}
<script is:inline define:vars={{ producto: { id: product.id, model: product.model, price: product.price, category: product.category } }}>
  if (typeof fbq === "function") {
    fbq("track", "ViewContent", {
      content_ids: [producto.id],
      content_name: producto.model,
      content_category: producto.category,
      content_type: "product",
      value: producto.price,
      currency: "ARS",
    });
  }
</script>

<script>
  const init = () => {
    const bar = document.getElementById("sticky_buy");
    const anchor = document.getElementById("comprar");
    if (!bar || !anchor) return;

    // La barra aparece recién cuando el bloque de compra salió de pantalla.
    const observer = new IntersectionObserver(
      ([entry]) => {
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle("opacity-0", !show);
        bar.classList.toggle("-translate-y-full", !show);
        bar.classList.toggle("pointer-events-none", !show);
      },
      { threshold: 0 },
    );
    observer.observe(anchor);

    document.getElementById("entregas_modal_btn")?.addEventListener("click", () => {
      const m = document.getElementById("entregas_modal");
      if (m instanceof HTMLDialogElement) m.showModal();
    });
    document.getElementById("pagos_modal_btn")?.addEventListener("click", () => {
      const m = document.getElementById("pagos_modal");
      if (m instanceof HTMLDialogElement) m.showModal();
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
