---
import Layout from "@/layouts/Layout.astro";
import { GUIAS } from "@/services/guias";
---

<Layout
  title="Guías para elegir cámaras de seguridad y alarmas | VIGI"
  description="Guías simples para elegir cámaras de seguridad, sistemas con DVR, cámaras a batería y alarmas para tu casa o negocio."
>
  <main class="m-auto max-w-[1180px] px-4 pb-8 sm:px-8">
    <nav class="flex items-center gap-2 py-3 text-xs text-gray-400">
      <a href="/" class="hover:underline">Inicio</a>
      <span>/</span>
      <span class="text-ink">Guías</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-primary sm:text-4xl">
      Guías de compra
    </h1>
    <p class="mt-4 max-w-[65ch] text-[15px] leading-relaxed text-muted">
      Lo que conviene saber antes de elegir una cámara o una alarma, explicado
      sin tecnicismos.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        GUIAS.map((g) => (
          <a
            href={`/guias/${g.slug}`}
            class="flex flex-col rounded-2xl border border-line bg-white p-6 transition-shadow hover:shadow-[0_10px_26px_rgba(30,5,63,0.08)]"
          >
            <h2 class="text-lg font-bold leading-snug tracking-tight text-primary">
              {g.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{g.description}</p>
            <span class="mt-5 text-sm font-semibold text-primary">Leer guía →</span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
