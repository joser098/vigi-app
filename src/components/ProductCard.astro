---
import { type Product } from "../services/types";
import Truck from "./Icons/Truck.astro";
import ShipBadge from "./ShipBadge.astro";

interface Props {
  product: Product;
  /** La primera fila de una grilla no debe cargar diferida: es LCP. */
  eager?: boolean;
}

const { product, eager = false } = Astro.props;

const money = (n: number) =>
  n.toLocaleString("es-AR", {
    style: "currency",
    currency: "ARS",
    maximumFractionDigits: 0,
  });

// Línea de facetas a partir de columnas que ya existen, para que la tarjeta
// diga algo útil sin depender de que el título esté bien escrito.
const facets = [
  product.location === "interior"
    ? "Interior"
    : product.location === "exterior"
      ? "Exterior"
      : null,
  product.power_type === "bateria" ? "A batería" : null,
  product.is_analogue ? "Análoga" : null,
  product.details?.resolution ?? null,
]
  .filter(Boolean)
  .slice(0, 3)
  .join(" · ");

const cuotas = Math.round(product.price / 3);
---

<a href={`/product/${product.model}`} class="group block">
  <article
    class="flex h-full w-60 flex-col rounded-2xl border border-line bg-white p-4 transition-shadow duration-300 hover:shadow-[0_16px_36px_rgba(30,5,63,0.11)]"
  >
    <div
      class="relative flex aspect-square items-center justify-center rounded-xl bg-panel p-7"
    >
      {
        /* Se gatilla con price_diferred y no con has_promotion: si el descuento
           quedó fuera del rango válido, la API manda price_diferred en null y
           la placa saldría vacía. */
        product.price_diferred && (
          <div class="gradient_violet absolute left-3 top-3 flex flex-col items-center rounded-lg px-2.5 py-1.5">
            <span class="text-[9px] leading-tight text-white">Ahorrás</span>
            <span class="text-[12.5px] font-bold leading-tight text-white">
              {money(product.price_diferred)}
            </span>
          </div>
        )
      }
      <img
        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
        src={product.thumbnail}
        alt={`${product.provider} ${product.model}`}
        width="240"
        height="240"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        decoding="async"
      />
    </div>

    <div class="flex flex-1 flex-col px-1 pt-4">
      <span
        class="text-[10px] font-bold uppercase tracking-[0.1em] text-gray-400"
        >{product.provider}</span
      >
      <h2 class="mt-1.5 text-base font-bold text-primary">{product.model}</h2>
      {
        facets && (
          <p class="mt-1.5 text-xs leading-relaxed text-muted">{facets}</p>
        )
      }

      <div class="mt-3.5 flex items-baseline gap-2">
        <p class="text-xl font-bold text-ink">{money(product.price)}</p>
        {
          product.price_original && (
            <p class="text-xs text-gray-400 line-through">
              {money(product.price_original)}
            </p>
          )
        }
      </div>
      <p class="mt-1 text-xs font-semibold text-green_">
        3 cuotas sin interés de {money(cuotas)}
      </p>

      <div class="mt-auto pt-3.5">
        <ShipBadge />
        <div class="flex items-center justify-center">
          <Truck height="15" width="15" color="#33BF5E" />
          <span class="px-2 py-1 text-[10px] font-bold text-green_"
            >Envío gratis</span
          >
        </div>
      </div>
    </div>
  </article>
</a>

<style is:global>
  .gradient {
    background: linear-gradient(
      120deg,
      rgb(223, 255, 160) 0%,
      rgb(230, 255, 219) 100%
    );
  }
  .gradient_violet {
    background: linear-gradient(to bottom right, #1e053fb9 0%, #1e053f 74%);
  }
</style>
