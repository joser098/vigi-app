---
import { getCarruselImages } from "@/services/fetchData";

// Las imágenes se cargan desde el admin y salen por /api/search/carrusel.
const carrusel = await getCarruselImages();
const slides: { image_url: string; link_url?: string }[] =
  carrusel?.images ?? [];
---

{
  slides.length > 0 && (
    <section class="relative" data-campaigns aria-roledescription="carrusel">
      <div class="overflow-hidden rounded-3xl">
        <div
          class="flex transition-transform duration-700 ease-out"
          data-campaign-track
        >
          {slides.map((slide, index) => {
            const image = (
              <img
                class="w-full object-cover"
                src={slide.image_url}
                alt={`Campaña ${index + 1}`}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
              />
            );
            return (
              <div class="w-full shrink-0">
                {/* Cada slide lleva a su propio link: antes un solo <a> envolvía
                    todas las imágenes con el link_url de la primera. */}
                {slide.link_url ? (
                  <a href={slide.link_url} class="block">
                    {image}
                  </a>
                ) : (
                  image
                )}
              </div>
            );
          })}
        </div>
      </div>

      {slides.length > 1 && (
        <>
          <button
            type="button"
            data-campaign-prev
            aria-label="Campaña anterior"
            class="absolute left-3 top-1/2 z-10 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-white/90 text-primary shadow-[0_6px_18px_rgba(30,5,63,0.12)] transition-opacity hover:bg-white sm:left-5"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            data-campaign-next
            aria-label="Campaña siguiente"
            class="absolute right-3 top-1/2 z-10 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-white/90 text-primary shadow-[0_6px_18px_rgba(30,5,63,0.12)] transition-opacity hover:bg-white sm:right-5"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>

          <div class="mt-4 flex items-center justify-center gap-2">
            {slides.map((_, index) => (
              <button
                type="button"
                data-campaign-dot={index}
                aria-label={`Ir a la campaña ${index + 1}`}
                aria-current={index === 0 ? "true" : "false"}
                class="h-[5px] w-[5px] rounded-full bg-gray-300 transition-all aria-[current=true]:w-6 aria-[current=true]:bg-primary"
              />
            ))}
          </div>
        </>
      )}
    </section>
  )
}

<script>
  const init = () => {
    const root = document.querySelector<HTMLElement>("[data-campaigns]");
    const track = root?.querySelector<HTMLElement>("[data-campaign-track]");
    if (!root || !track) return;

    const dots = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-campaign-dot]"),
    ];
    const count = track.children.length;
    if (count < 2) return;

    let current = 0;
    const go = (index: number) => {
      current = (index + count) % count;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", String(i === current)),
      );
    };

    dots.forEach((dot, index) => dot.addEventListener("click", () => go(index)));
    root
      .querySelector<HTMLButtonElement>("[data-campaign-prev]")
      ?.addEventListener("click", () => go(current - 1));
    root
      .querySelector<HTMLButtonElement>("[data-campaign-next]")
      ?.addEventListener("click", () => go(current + 1));

    // Respetamos a quien pidió menos movimiento en el sistema.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    window.setInterval(() => go(current + 1), 6500);
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
