---
import {
  CONTACT_LABEL,
  CONTACT_PREP,
  CONTACT_TARGET,
  CONTACT_URL,
  whatsappAcordar,
} from "@/services/contacto";
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import PayApproved from "@/components/PayApproved.astro";
import PayNotApproved from "@/components/PayNotApproved.astro";
import { getAcordarStatus, getPayment } from "@/services/fetchData";
import PurchasePixel from "@/components/PurchasePixel.astro";
import PurchaseGa4 from "@/components/PurchaseGa4.astro";

const { id } = Astro.params;

// La API guarda el pago cualquiera sea su estado, así que esta pantalla los
// muestra todos. Antes solo entendía "approved" y cualquier otra cosa rebotaba
// a /profile: un pago rechazado dejaba al cliente en su perfil sin una palabra
// sobre qué había pasado.
let payment;

if (id) {
  //TODO: Verificar que el pago sea del usuario logeado
  payment = await getPayment(id);
}

// Sin fila todavía no se puede decir nada útil. Pasa en la ventana entre que el
// cliente vuelve y que se registra el pago; el propio feedback lo registra
// antes de redirigir, así que es raro, pero no imposible.
if (!payment) {
  return Astro.redirect("/profile");
}

const aprobado = payment.status === "approved";

// Si eligió "acordar el envío", tiene que escribirnos por WhatsApp con el
// número de pedido: se le da el botón con el mensaje ya armado.
const acordar = aprobado ? (await getAcordarStatus(id!))?.acordar === true : false;

// El mismo total que muestra PayApproved, sacado de las mismas dos fuentes: lo
// que Meta cuente como venta tiene que ser lo que el cliente ve en pantalla.
const totalPagado =
  payment?.transaction_details?.total_paid_amount ?? payment?.amount ?? null;
---

<Layout title={aprobado ? "Tu compra | VIGI" : "Estado de tu pago | VIGI"}>
  <main class="m-auto max-w-[1180px] px-4 py-12 sm:px-8 sm:py-16">
    {
      aprobado ? (
        <>
          <PurchasePixel paymentId={id!} total={totalPagado} />
          <PurchaseGa4 paymentId={id!} total={totalPagado} />

          <PayApproved payment={payment} />

          {acordar && (
            <div class="mx-auto mt-8 max-w-xl rounded-2xl border-2 border-primary bg-white p-6 text-center">
              <h2 class="text-lg font-bold text-primary">Falta coordinar la entrega</h2>
              <p class="mt-2 text-[14px] leading-relaxed text-muted">
                Elegiste acordar el envío. Escribinos por WhatsApp con tu número
                de pedido, <strong class="text-ink">{id}</strong>, y coordinamos
                el punto, el día y el horario de entrega en CABA.
              </p>
              <a
                href={whatsappAcordar(id!)}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex h-[52px] items-center justify-center rounded-full bg-[#25D366] px-7 text-[15px] font-semibold text-white"
              >
                Coordinar por WhatsApp
              </a>
            </div>
          )}

          <div class="mx-auto mt-8 flex max-w-xl flex-col gap-3 sm:flex-row">
            <a
              href="/profile"
              class="inline-flex h-[52px] flex-1 items-center justify-center rounded-full bg-primary px-7 text-[15px] font-semibold text-white"
            >
              Ver mis compras
            </a>
            <a
              href="/"
              class="inline-flex h-[52px] flex-1 items-center justify-center rounded-full border-[1.5px] border-gray-300 bg-white px-7 text-[15px] font-semibold text-primary"
            >
              Seguir comprando
            </a>
          </div>

          <p class="mx-auto mt-8 max-w-xl text-center text-[13px] leading-relaxed text-muted">
            ¿Algo no cierra con tu pedido? Escribinos {CONTACT_PREP}
            <a
              href={CONTACT_URL}
              target={CONTACT_TARGET}
              rel="noopener"
              class="font-semibold text-primary underline"
            >
              {CONTACT_LABEL}
            </a>
            con el número de pago.
          </p>
        </>
      ) : (
        <PayNotApproved
          status={payment.status}
          statusDetail={payment.status_detail}
          paymentId={payment.gateway_payment_id}
        />
      )
    }
  </main>
</Layout>
